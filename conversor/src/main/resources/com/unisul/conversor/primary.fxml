<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="466.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unisul.conversor.PrimaryController">
   <children>
      <Label text="Dados Iniciais" />
      <VBox prefHeight="75.0" prefWidth="760.0" style="-fx-background-color: gray;">
         <children>
            <Label text="Número Decimal" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="txtDecimal" />
                  <Button mnemonicParsing="false" onAction="#onCopiarDecimal" text="Button" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox accessibleText="a" prefHeight="68.0" prefWidth="760.0" style="-fx-background-color: gray;">
         <children>
            <Label text="Número Binário" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="txtBinario" />
                  <Button mnemonicParsing="false" onAction="#onCopiarBinario" text="Button" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="70.0" prefWidth="760.0" style="-fx-background-color: gray;">
         <children>
            <Label text="Número Octal" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="txtOctal" />
                  <Button mnemonicParsing="false" onAction="#onCopiarOctal" text="Button" />
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox prefHeight="65.0" prefWidth="760.0" style="-fx-background-color: gray;">
         <children>
            <Label text="Número Hexadecimal" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="txtHexadecimal" />
                  <Button mnemonicParsing="false" onAction="#onCopiarHexadecimal" text="Button" />
               </children>
            </HBox>
         </children>
      </VBox>
      <Button mnemonicParsing="false" onAction="#onRestabelecer" text="Reestabelece" textAlignment="CENTER" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>