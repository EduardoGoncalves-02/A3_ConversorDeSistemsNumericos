<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="560.0" prefWidth="640.0" spacing="12.0" style="-fx-background-color: linear-gradient(to bottom right, #101827, #17263b);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unisul.conversor.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="22.0" />
   </padding>
   <children>
      <VBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Label style="-fx-text-fill: #72d6c9; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1.2px;" text="CONVERSOR DE SISTEMAS NUMÉRICOS" />
            <Label style="-fx-text-fill: white; -fx-font-size: 27px; -fx-font-weight: bold;" text="Conversor de Bases" />
            <Label style="-fx-text-fill: #aebbd0; -fx-font-size: 12px;" text="Digite um valor em qualquer base e veja as conversões instantaneamente." wrapText="true" />
         </children>
      </VBox>

      <VBox spacing="9.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
               <padding><Insets bottom="9.0" left="12.0" right="12.0" top="9.0" /></padding>
               <children>
                  <Label style="-fx-text-fill: #637083; -fx-font-size: 10px; -fx-font-weight: bold;" text="DECIMAL  ·  BASE 10" />
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <TextField fx:id="txtDecimal" promptText="Ex.: 125" style="-fx-background-color: #f5f7fb; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dce3ed; -fx-font-size: 14px; -fx-text-fill: #17263b; -fx-prompt-text-fill: #9aa6b7;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onCopiarDecimal" style="-fx-background-color: #e8f4f2; -fx-text-fill: #187f75; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Copiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
               <padding><Insets bottom="9.0" left="12.0" right="12.0" top="9.0" /></padding>
               <children>
                  <Label style="-fx-text-fill: #637083; -fx-font-size: 10px; -fx-font-weight: bold;" text="BINÁRIO  ·  BASE 2" />
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <TextField fx:id="txtBinario" promptText="Ex.: 1111101" style="-fx-background-color: #f5f7fb; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dce3ed; -fx-font-size: 14px; -fx-text-fill: #17263b; -fx-prompt-text-fill: #9aa6b7;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onCopiarBinario" style="-fx-background-color: #e8f4f2; -fx-text-fill: #187f75; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Copiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
               <padding><Insets bottom="9.0" left="12.0" right="12.0" top="9.0" /></padding>
               <children>
                  <Label style="-fx-text-fill: #637083; -fx-font-size: 10px; -fx-font-weight: bold;" text="OCTAL  ·  BASE 8" />
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <TextField fx:id="txtOctal" promptText="Ex.: 175" style="-fx-background-color: #f5f7fb; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dce3ed; -fx-font-size: 14px; -fx-text-fill: #17263b; -fx-prompt-text-fill: #9aa6b7;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onCopiarOctal" style="-fx-background-color: #e8f4f2; -fx-text-fill: #187f75; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Copiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
               <padding><Insets bottom="9.0" left="12.0" right="12.0" top="9.0" /></padding>
               <children>
                  <Label style="-fx-text-fill: #637083; -fx-font-size: 10px; -fx-font-weight: bold;" text="HEXADECIMAL  ·  BASE 16" />
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <TextField fx:id="txtHexadecimal" promptText="Ex.: 7D" style="-fx-background-color: #f5f7fb; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dce3ed; -fx-font-size: 14px; -fx-text-fill: #17263b; -fx-prompt-text-fill: #9aa6b7;" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onCopiarHexadecimal" style="-fx-background-color: #e8f4f2; -fx-text-fill: #187f75; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Copiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="8.0">
         <children>
            <Label style="-fx-text-fill: #9eacc1; -fx-font-size: 11px;" text="Conversões em tempo real" />
            <Button mnemonicParsing="false" onAction="#onRestabelecer" style="-fx-background-color: #25364e; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-padding: 9 18 9 18; -fx-cursor: hand;" text="Limpar campos" />
         </children>
      </HBox>
   </children>
</VBox>
